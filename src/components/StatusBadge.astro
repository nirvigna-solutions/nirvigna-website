---
import { STATUS_LABELS, type ProductStatus } from '../config/site';

interface Props {
  status: ProductStatus;
}
const { status } = Astro.props;
const styles: Record<ProductStatus, string> = {
  earlyAccess: 'bg-brand-100 text-brand-900 ring-brand-300',
  inDevelopment: 'bg-amber-100 text-amber-950 ring-amber-300',
};
---

<span class:list={['inline-flex items-center rounded-full px-3 py-1 text-sm font-semibold ring-1 ring-inset', styles[status]]}>
  {STATUS_LABELS[status]}
</span>
