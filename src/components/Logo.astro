---
/**
 * PLACEHOLDER logo (see docs/CONTENT_DECISIONS.md). Replace the mark with the approved logo
 * when supplied. Deliberately plain: no emblem-like or authority-like shapes.
 */
import { COMPANY } from '../config/site';

interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<span class:list={['inline-flex items-center gap-2', className]} data-placeholder="logo">
  <svg width="32" height="32" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
    <rect width="32" height="32" rx="8" fill="#2236b8"></rect>
    <path d="M10 23V9h2.6l6.8 9.6V9H22v14h-2.6l-6.8-9.6V23z" fill="#ffffff"></path>
  </svg>
  <span class="text-xl font-bold tracking-tight text-slate-900">{COMPANY.brand}</span>
</span>
