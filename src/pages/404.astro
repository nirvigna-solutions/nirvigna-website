---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="The page you were looking for could not be found." noindex>
  <section class="container-page max-w-3xl py-16 sm:py-24" data-testid="not-found">
    <p class="font-semibold text-brand-700">404</p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight sm:text-4xl">Page not found</h1>
    <p class="mt-4 text-lg leading-relaxed text-slate-700">The page may have moved, or the address may be mistyped.</p>
    <p class="mt-8 flex flex-wrap gap-3">
      <a href="/" class="btn-primary">Go to the home page</a>
      <a href="/contact/" class="btn-secondary">Contact us</a>
    </p>
  </section>
</BaseLayout>
