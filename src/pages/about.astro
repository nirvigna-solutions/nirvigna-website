---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import { ADDRESS_ONE_LINE, COMPANY, PRODUCTS, TEAM } from '../config/site';
---

<BaseLayout
  title="About"
  description={`About ${COMPANY.brand}: a Hyderabad company building ${PRODUCTS.compliance.name} to make licence requirements clear for Indian businesses, starting with Telangana.`}
>
  <PageHero
    title={`About ${COMPANY.brand}`}
    lead="We think a business owner should be able to see which licences apply to them, and why, without having to piece it together from scattered sources."
  />

  <Section title="What we are building">
    <div class="max-w-3xl space-y-4 leading-relaxed text-slate-700">
      <p>
        {PRODUCTS.compliance.name} starts from a profile of your business and shows each licence that applies, with the reason and
        the Act and section behind it. When it does not have enough facts, it says “we can’t tell yet”. It is in early access,
        starting with Telangana.
      </p>
      <p>
        {PRODUCTS.foodSafety.name}, a food-safety app for restaurants, hotels and food units, is in development.
      </p>
      <p>We organise the work. Regulated filings are done by a qualified CA/CS.</p>
    </div>
  </Section>

  {
    TEAM.length > 0 && (
      <Section title="Team" tone="muted">
        <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {TEAM.map((m) => (
            <li class="rounded-xl border border-slate-200 bg-white p-6">
              <p class="font-semibold text-slate-900">{m.name}</p>
              <p class="text-slate-700">{m.role}</p>
            </li>
          ))}
        </ul>
      </Section>
    )
  }

  <Section title="Company details" tone="muted">
    <dl class="grid max-w-3xl gap-x-8 gap-y-4 sm:grid-cols-[auto_1fr]">
      <dt class="font-semibold text-slate-900">Legal name</dt>
      <dd>{COMPANY.legalName}</dd>
      <dt class="font-semibold text-slate-900">CIN</dt>
      <dd>{COMPANY.cin}</dd>
      <dt class="font-semibold text-slate-900">Incorporated</dt>
      <dd>{COMPANY.incorporatedDisplay}</dd>
      <dt class="font-semibold text-slate-900">Registered office</dt>
      <dd>{ADDRESS_ONE_LINE}</dd>
      <dt class="font-semibold text-slate-900">Contact</dt>
      <dd><a href="/contact/" class="link">Contact us</a></dd>
    </dl>
  </Section>
</BaseLayout>
